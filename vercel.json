{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {"source":"/(.*)\\.(js|css|svg|png|jpg|jpeg|webp|gif|mp4)","headers":[{"key":"Cache-Control","value":"public,max-age=31536000,immutable"}]},
    {"source":"/(.*)\\.html","headers":[{"key":"Cache-Control","value":"public,max-age=300"}]}
  ]
}
